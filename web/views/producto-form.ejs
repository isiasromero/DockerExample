<%- include('partials/header') %>

<h1>Registrar producto</h1>
<p class="lead">Los datos se guardan en la tabla <span class="mono">productos</span> de MySQL, que corre en el contenedor <span class="mono">mysql-db</span>.</p>

<div class="rejilla rejilla--form">
  <section class="tarjeta">
    <% if (errores.length) { %>
      <div class="alerta alerta--error" role="alert"><ul><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
    <% } %>
    <form method="post" action="/productos" class="formulario" novalidate>
      <label>Categoría
        <select name="categoria_id" required>
          <option value="">Seleccione...</option>
          <% categorias.forEach(c => { %>
            <option value="<%= c.id %>" <%= Number(datos.categoria_id) === c.id ? 'selected' : '' %>><%= c.nombre %> (<%= c.codigo %>)</option>
          <% }) %>
        </select>
      </label>
      <label>Nombre del producto
        <input name="nombre" maxlength="100" required value="<%= datos.nombre || '' %>" placeholder="Ej. Mouse inalámbrico" autofocus>
      </label>
      <div class="fila-2">
        <label>Precio (COP)
          <input type="number" name="precio" min="0" step="0.01" required value="<%= Number.isFinite(datos.precio) ? datos.precio : '' %>" placeholder="45000">
        </label>
        <label>Stock (unidades)
          <input type="number" name="stock" min="0" step="1" required value="<%= Number.isInteger(datos.stock) ? datos.stock : '' %>">
        </label>
      </div>
      <label>Fecha de ingreso
        <input type="date" name="fecha_ingreso" required value="<%= datos.fecha_ingreso || '' %>">
      </label>
      <label class="check"><input type="checkbox" name="disponible" <%= datos.disponible ? 'checked' : '' %>> Disponible para la venta</label>
      <button class="boton" type="submit">Guardar en la base de datos</button>
    </form>
  </section>

  <aside class="tarjeta">
    <h2 class="tarjeta__titulo">Progreso</h2>
    <div class="cifras"><div><strong><%= total %></strong><span>productos guardados</span></div></div>
    <div class="progreso"><div class="progreso__barra" style="width: <%= Math.min(100, Math.round(total / 15 * 100)) %>%"></div></div>
    <small class="tenue">Meta: 15 registros</small>
    <hr>
    <h3 class="tarjeta__titulo">Tipos de datos</h3>
    <ul class="tipos">
      <li><span class="mono">categoria_id</span> INT (llave foránea)</li>
      <li><span class="mono">nombre</span> VARCHAR(100)</li>
      <li><span class="mono">precio</span> DECIMAL(10,2)</li>
      <li><span class="mono">stock</span> INT</li>
      <li><span class="mono">disponible</span> BOOLEAN</li>
      <li><span class="mono">fecha_ingreso</span> DATE</li>
    </ul>
    <a class="boton boton--sec boton--bloque" href="/productos">Ver datos guardados →</a>
  </aside>
</div>

<%- include('partials/footer') %>
